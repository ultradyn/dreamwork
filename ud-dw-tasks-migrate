#!/usr/bin/env python3
"""ud-dw-tasks-migrate — the parse-and-report half of the tasks.md → SQLite
migration (#294 increment 3, design .dreamwork/docs/plans/ledger-sqlite.md).

The design's eventual surface is ``dreamwork tasks migrate``; no ``dreamwork``
dispatcher exists yet, so this follows the repo's CLI layout (``ud-dw-user-
events``, ``ud-dw-generate``): one extensionless executable at the skill root,
loadable by path for tests. A later dispatcher can shell to it unchanged.

Increment 4 adds ``--import``/``--verify`` into a SCRATCH database (never
``.dreamwork/`` — cutover is R4, a later increment; see below). The parse
half is unchanged: it parses every open AND landed entry through
the PRODUCTION parser — ``watch.parse_ledger`` for the open/landed id sets and
``ledger_parse.ledger_entries`` for the entry/origin grammar, the one copy
#352 exists to keep single; five hand-rolled ledger parsers have been wrong in
this repo, so this script writes no sixth. It reports exact counts, the id
set, per-entry digests, every conflict it can detect, and the seed the store's
id sequence WOULD take (R1, verified via ``ledger_store.derive_next_id``). It
writes NOTHING — no database, no ledger edit. The report is the deliverable.

Deliberately readable and user-modifiable (G7): field extraction that has no
production reader (priority bands are prose ``·``-fields in tasks.md — #346
measured them with its own scan) lives here in small named functions with the
closed sets imported from ``ledger_store``, never copied.

Stable exit codes (asserted by test_tasks_migrate.py / test_tasks_migrate_import.py):

    0   report rendered / import+verify clean — conflicts are OUTPUT (#346)
    64  EX_USAGE      bad arguments (e.g. --import without --to)
    65  EX_DATAERR    unparseable ledger; import refused (fatal conflicts);
                      verification divergence (each failure NAMES the row)
    66  EX_NOINPUT    ledger file missing / unreadable
    77  EX_NOPERM     --to points inside .dreamwork/ — the live location

Usage: ud-dw-tasks-migrate --dry-run [--ledger PATH] [--report PATH]
       ud-dw-tasks-migrate --import --to SCRATCH.db [--ledger PATH]
       ud-dw-tasks-migrate --verify --to SCRATCH.db [--ledger PATH]

Import rules (all ruled in increments 2–3 or #346; nothing guessed):

- one ``task`` row per id — a combined entry gives each id a row sharing
  body/digest/title/band/type/origin; duplicate ids, strays, id-less heads
  and seed drift REFUSE the import (exit 65), they have no resolution;
- band: closed-set as-is; compound → LOWER band + priority_uncertain=1 (S2);
  missing → P2 by contract; single out-of-set (P4) → NULL, never a guess;
- type: only a whole ``·``-field in KNOWN_TYPES, else NULL (#346 finding 5),
  registered in the task_type lookup;
- origin: one in-vocabulary marker as-is; out-of-vocabulary/multiple fail
  closed to ``unknown``; NULL iff every id < 216 (#346 finding 4);
- related: symmetric pairs (a<b) between existing ids; depends: directed
  edges from the two recognised blocked-on forms; dangling targets skip;
- the sequence is seeded by ledger_store (verified, re-seed only upward) and
  asserted == the ledger's next id after import;
- idempotent: a second --import over the same DB populates nothing and
  reports a no-op with identical verification; a DIVERGENT DB fails
  verification loudly, naming every divergent row.
"""

from __future__ import annotations

import argparse
import hashlib
import re
import sqlite3
import sys
from collections import Counter
from pathlib import Path

EX_OK = 0
EX_USAGE = 64
EX_DATAERR = 65
EX_NOINPUT = 66

# The skill's own modules (lint, ledger_parse, ledger_store) sit beside this
# script; put that directory on the path so the CLI runs from any cwd.
sys.path.insert(0, str(Path(__file__).resolve().parent))

import ledger_parse  # noqa: E402 — the ONE entry/origin grammar (#352)
import ledger_store  # noqa: E402 — closed sets + verified seed derivation
import lint  # noqa: E402 — load_watch(), NEXT_ID, RELATED_MARKER

# A priority band in tasks.md is a whole `·`-field of the shape P<n> — or the
# compound P<n>/P<m>, which S2 rules imports as the LOWER band with
# priority_uncertain=1. A field merely CONTAINING "P1" is prose, not a band.
BAND_FIELD = re.compile(r"^P\d+(/P\d+)*$")
# A band field may be bolded whole (`· **P1** ·` — #465's shape); a bolded
# band EMBEDDED in a title (#99's `**P2** The popout composer…`) is not a
# field and is reported as missing-with-evidence, not silently read.
BOLD_FIELD = re.compile(r"^\*\*(.+?)\*\*$")
BOLD_BAND_TOKEN = re.compile(r"\*\*(P\d+(/P\d+)*)\*\*")
# `blocked on #N` stays prose (lint's comment at BLOCKED_ON_HUMAN_MARK: a
# task-blocker is a different relation); the field form `blocked-on: **…**`
# is lint's production marker. Both are read here, never re-anchored wider.
BLOCKED_ON_PROSE = re.compile(r"blocked on (#\d+)", re.I)

ORIGIN_CONTRACT_MIN_ID = 216  # file-formats.md: origin is forward-only from #216


# ---------------------------------------------------------------------------
# Field extraction — the parts of an entry with no production reader.
# Entry/id/origin/related come from ledger_parse + lint; bands and the prose
# blocked-on phrase are tasks.md prose fields (#346 found no reader), so they
# are read here in small functions against ledger_store's closed sets.
# ---------------------------------------------------------------------------

def band_fields(body: str) -> list[str]:
    """Every whole `·`-field that is a band shape (P<n>, or compound P<n>/P<m>).

    A wholly-bolded field (`**P1**`) counts — #346 measured that shape in the
    live ledger. A bolded band inside a longer title does NOT: it is prose
    emphasis, and reading it as the entry's band would invent structure.
    """
    out = []
    for frag in body.split("·"):
        f = frag.strip()
        m = BOLD_FIELD.match(f)
        if m:
            f = m.group(1).strip()
        if BAND_FIELD.match(f):
            out.append(f)
    return out


def band_import_rule(field: str) -> tuple[str, int]:
    """The (band, priority_uncertain) a band field imports as (S2).

    A single band in the closed set imports as itself, uncertain 0. A compound
    (`P0/P1`) imports as the LOWER band — the numerically higher member — with
    priority_uncertain=1, because the compound means "urgent, not yet certain
    which" and resolving it to the stronger band would edit the author's prose.
    """
    members = field.split("/")
    lower = f"P{max(int(m[1:]) for m in members)}"
    return lower, 1 if len(members) > 1 else 0


def related_ids(body: str) -> list[int]:
    """Ids named by `related: **…**` fields — lint's production marker regex."""
    return [int(x) for m in lint.RELATED_MARKER.finditer(body)
            for x in ledger_parse.ENTRY_ID.findall(m.group(1))]


def blocked_on_ids(body: str) -> list[int]:
    """Ids named by `blocked on #N` prose or a `blocked-on: **…**` field."""
    ids = [int(m.group(1)[1:]) for m in BLOCKED_ON_PROSE.finditer(body)]
    for m in lint.BLOCKED_ON_HUMAN_MARK.finditer(body):
        ids += [int(x) for x in ledger_parse.ENTRY_ID.findall(m.group(1))]
    return ids


# ---------------------------------------------------------------------------
# Import field extraction (#294 increment 4). Same discipline as the dry-run:
# closed sets come from ledger_store, prose shapes from the functions above.
# ---------------------------------------------------------------------------

# The genuine task types #346 measured (finding 5 / S4): a whole `·`-field
# outside this set imports type as NULL — a misdetected type is worse than
# none, and the fields are not positional (65 distinct values sit where a
# type should be: durations, `landed …`, even `origin:` markers).
KNOWN_TYPES = ("idea", "task", "bug", "chore", "feature", "design",
               "implementation", "reliability")

# Conflicts that make an import impossible rather than lossy. Everything
# else the dry-run reports is a legal shape with a ruled resolution.
FATAL_CONFLICTS = ("duplicate ids", "entry outside both sections",
                   "entry head without an id", "seed verification")


def entry_type(body: str) -> str | None:
    """The task's type from an unambiguous whole `·`-field, else NULL (#346)."""
    for frag in body.split("·"):
        f = frag.strip()
        m = BOLD_FIELD.match(f)
        if m:
            f = m.group(1).strip()
        if f in KNOWN_TYPES:
            return f
    return None


def entry_band(body: str) -> tuple[str | None, int]:
    """The (priority, priority_uncertain) an entry imports as.

    First band field wins. In the closed set: itself, certain. Compound:
    the LOWER band + uncertain (S2, same rule the dry-run reports). Missing:
    P2 by contract. A single band outside the closed set (P4) imports NULL —
    the band was stated but is not in the vocabulary; guessing P3 would edit
    the author's prose.
    """
    bands = band_fields(body)
    if not bands:
        return "P2", 0
    first = bands[0]
    if first in ledger_store.PRIORITY_BANDS:
        return first, 0
    if "/" in first:
        return band_import_rule(first)
    return None, 0


def entry_origin(ids: list[int], body: str) -> str | None:
    """The origin an entry imports as; NULL only for pre-216 unmarked entries.

    #346 finding 4: absence is derivable from the id, so the invariant is
    assertable — origin IS NULL iff every leading id < 216. One in-vocabulary
    marker imports as itself; out-of-vocabulary or multiple markers fail
    closed to 'unknown' (the dry-run's reported resolution), never a guess.
    """
    marks = [m.strip() for m in ledger_parse.ORIGIN_MARK.findall(body)]
    if len(marks) == 1 and marks[0] in ledger_store.ORIGINS:
        return marks[0]
    if not marks and all(i < ORIGIN_CONTRACT_MIN_ID for i in ids):
        return None
    return "unknown"


def head_title(body: str) -> str:
    """The head line's prose after the `- **#…** —` marker, before the fields.

    tasks.md has no title marker: the title is the head line up to the first
    `·`-field. Falls back to the full head line, then to the id itself, so
    the NOT NULL column can never receive an empty title from odd prose.
    """
    head = body.splitlines()[0]
    m = ledger_parse.ENTRY_HEAD.match(head)
    rest = head[m.end():] if m else head
    rest = rest.strip()
    if rest.startswith("—"):
        rest = rest[1:].strip()
    title = rest.split("·")[0].strip()
    return title or rest or head.strip()


def blocked_on_text(body: str) -> str | None:
    """The verbatim blocked-on evidence: the dry-run's two recognised shapes.

    `blocked on #N` prose matches and whole `blocked-on: **…**` fields,
    semicolon-joined, exactly as written — never paraphrased, never widened
    to prose the dry-run does not also read.
    """
    parts = [m.group(0) for m in BLOCKED_ON_PROSE.finditer(body)]
    parts += [m.group(0) for m in lint.BLOCKED_ON_HUMAN_MARK.finditer(body)]
    return "; ".join(parts) if parts else None


def _source_lines(text: str, entries: list[dict]) -> dict[int, int]:
    """1-based head line of each entry's first id, found sequentially.

    ledger_parse bodies are verbatim substrings of the ledger, so each body
    is located after the previous one; a body that does not appear where the
    grammar put it is a parse bug, asserted rather than skipped.
    """
    lines, pos = {}, 0
    for e in entries:
        idx = text.find(e["body"], pos)
        assert idx >= 0, "entry body not found in ledger — parser disagreement"
        line = text.count("\n", 0, idx) + 1
        for i in e["ids"]:
            lines[i] = line
        pos = idx + 1
    return lines


def expected_tasks(text: str, a: dict) -> dict[int, dict]:
    """Every task row the parse implies, keyed by id — the import's replay.

    One row per id; a combined entry gives each of its ids a row sharing
    body, digest, title, band, type, and origin. Requires the analysis to be
    free of fatal conflicts (checked by the caller), so ids are unique.
    """
    lines = _source_lines(text, a["entries"])
    rows = {}
    for e in a["entries"]:
        band, uncertain = entry_band(e["body"])
        for i in e["ids"]:
            rows[i] = {
                "id": i,
                "state": "open" if i in set(a["open_ids"]) else "landed",
                "title": head_title(e["body"]),
                "body": e["body"],
                "priority": band,
                "priority_uncertain": uncertain,
                "type": entry_type(e["body"]),
                "origin": entry_origin(e["ids"], e["body"]),
                "blocked_on": blocked_on_text(e["body"]),
                "body_digest": e["digest"],
                "source_line": lines[i],
            }
    return rows


def expected_related(a: dict) -> set[tuple[int, int]]:
    """Symmetric related pairs (a < b) between imported ids, deduped.

    Every id of the stating entry inherits the relation. A dangling target
    (the dry-run's reported conflict) creates no edge — the FK would fail,
    and inventing the target is worse than skipping the pair.
    """
    ids = set(a["open_ids"]) | set(a["landed_ids"])
    pairs = set()
    for e in a["entries"]:
        for r in related_ids(e["body"]):
            for own in e["ids"]:
                if r in ids and r != own:
                    pairs.add((min(own, r), max(own, r)))
    return pairs


def expected_depends(a: dict) -> set[tuple[int, int]]:
    """Directed depends edges (task, needs) from recognised blocked-on forms.

    Only machine-recognisable shapes — the same two the dry-run reads —
    become edges (#346: prose is not parsed into obligations); `blocked-on:
    **human**` names no id and creates none.
    """
    ids = set(a["open_ids"]) | set(a["landed_ids"])
    edges = set()
    for e in a["entries"]:
        for n in blocked_on_ids(e["body"]):
            for own in e["ids"]:
                if n in ids and n != own:
                    edges.add((own, n))
    return edges


class _UsageParser(argparse.ArgumentParser):
    def error(self, message):  # argparse exits 2; the contract says 64
        self.exit(EX_USAGE, f"{self.prog}: error: {message}\n")


def _load_watch_or_die():
    watch = lint.load_watch()
    if watch is None:
        raise _Unparseable("watch.py unimportable — the production parser is missing")
    return watch


class _Unparseable(Exception):
    """The ledger cannot be parsed at all — the ONLY nonzero-report cause."""


def build_analysis(text: str, *, ledger_path: str) -> dict:
    """Parse the whole ledger through the production parser into one report dict.

    Counts come from ``watch.parse_ledger`` (the open/landed id sets every
    consumer uses); entries come from ``ledger_parse.ledger_entries`` (the one
    entry grammar). The two answer different questions, and the report keeps
    both so a disagreement between them — an entry head outside both sections
    — is itself a reported conflict rather than a silent skew.
    """
    watch = _load_watch_or_die()
    open_raw, landed_raw = watch.parse_ledger(text)
    if not re.search(watch.LEDGER_SEC_OPEN, text):
        raise _Unparseable("no `## Open` section heading — not a task ledger")
    entries = ledger_parse.ledger_entries(text)
    open_ids = {int(x) for x in open_raw}
    landed_ids = {int(x) for x in landed_raw}
    if not (open_ids | landed_ids):
        raise _Unparseable("parse_ledger found no ids — empty or unparseable ledger")
    parsed = []
    for ids, body in entries:
        if any(i in open_ids for i in ids):
            section = "open"
        elif any(i in landed_ids for i in ids):
            section = "landed"
        else:
            section = "stray"  # a head outside both sections — #484's old home
        parsed.append({
            "ids": list(ids),
            "section": section,
            "digest": hashlib.sha256(body.encode()).hexdigest(),
            "body": body,
        })
    a = {
        "ledger_path": ledger_path,
        "open_ids": sorted(open_ids),
        "landed_ids": sorted(landed_ids),
        "open_count": len(open_ids),
        "landed_count": len(landed_ids),
        "total_ids": len(open_ids | landed_ids),
        "disjoint": not (open_ids & landed_ids),
        "entries": parsed,
        "conflicts": {},
        "seed": {},
    }
    _detect_conflicts(a, text)
    return a


def _flag(conflicts: dict, category: str, *, id, detail: str, ids=None):
    conflicts.setdefault(category, []).append({"id": id, "detail": detail, "ids": ids})


def _detect_conflicts(a: dict, text: str) -> None:
    """Every conflict the dry-run can detect. Output, never an error (#346)."""
    c = a["conflicts"]
    open_ids, landed_ids = set(a["open_ids"]), set(a["landed_ids"])
    exists = open_ids | landed_ids | {i for e in a["entries"] for i in e["ids"]}
    head_counts = {}
    for e in a["entries"]:
        for i in e["ids"]:
            head_counts[i] = head_counts.get(i, 0) + 1
    for i in sorted(set(open_ids & landed_ids)
                    | {i for i, n in head_counts.items() if n > 1}):
        _flag(c, "duplicate ids", id=i,
              detail=f"#{i} heads {head_counts.get(i, 0)} entr"
              f"{'y' if head_counts.get(i, 0) == 1 else 'ies'}"
              + ("; in BOTH open and landed" if i in open_ids and i in landed_ids else ""))
    for e in a["entries"]:
        first = e["ids"][0] if e["ids"] else None
        if not e["ids"]:
            _flag(c, "entry head without an id", id=None,
                  detail=e["body"].splitlines()[0][:80])
            continue
        if e["section"] == "stray":
            for i in e["ids"]:
                _flag(c, "entry outside both sections", id=i,
                      detail=f"#{i} heads an entry in neither ## Open nor ## Recently landed")
        if len(e["ids"]) > 1:
            _flag(c, "combined entries surviving", id=first, ids=e["ids"],
                  detail="one entry head names " + "/".join(f"#{i}" for i in e["ids"]))
        bands = band_fields(e["body"])
        if not bands:
            embedded = BOLD_BAND_TOKEN.search(e["body"])
            evidence = (f"; it carries '**{embedded.group(1)}**' embedded in "
                        "prose, not as a `·`-field" if embedded else "")
            _flag(c, "missing band (P2 by contract)", id=first,
                  detail=f"#{first} carries no band field{evidence} — imports as P2")
        for b in bands:
            if b not in ledger_store.PRIORITY_BANDS:
                lower, uncertain = band_import_rule(b)
                note = (f"compound band '{b}' → imports as {lower}, priority_uncertain=1"
                        if "/" in b else
                        f"band '{b}' is outside the closed set P0..P3")
                _flag(c, "band outside closed set", id=first, detail=f"#{first}: {note}")
        # Origin: the contract vocabulary is lint.ORIGIN_VALUES / the store's
        # CHECK (human|loop|unknown) — `unknown` is a FIRST-CLASS value
        # (lint.check_task_origins: "not a failure"), distinct from
        # ledger_parse.KNOWN_ORIGINS, which is the claim-classification
        # subset. Enforcement scope mirrors lint: the #216 cutoff governs
        # absence and multiplicity; a single out-of-vocabulary value is a
        # conflict at any id because import would fail-closed over real prose.
        marks = [m.strip() for m in ledger_parse.ORIGIN_MARK.findall(e["body"])]
        if len(marks) == 1 and marks[0] not in ledger_store.ORIGINS:
            _flag(c, "origin outside closed set", id=first,
                  detail=f"#{first}: origin '{marks[0]}' is outside "
                  "human|loop|unknown — imports as unknown (fail-closed)")
        elif len(marks) > 1 and any(i >= ORIGIN_CONTRACT_MIN_ID for i in e["ids"]):
            _flag(c, "origin outside closed set", id=first,
                  detail=f"#{first}: {len(marks)} origin markers — the contract says one")
        elif not marks and any(i >= ORIGIN_CONTRACT_MIN_ID for i in e["ids"]):
            _flag(c, "origin absent at id >= 216", id=first,
                  detail=f"#{first} is past the #216 origin contract and carries no marker")
        for r in sorted(set(related_ids(e["body"])) - exists):
            _flag(c, "related id does not exist", id=r,
                  detail=f"#{first} names related #{r}, which no entry or section holds")
        for b in sorted(set(blocked_on_ids(e["body"])) - exists):
            _flag(c, "blocked-on id does not exist", id=b,
                  detail=f"#{first} is blocked on #{b}, which no entry or section holds")
    _verify_seed(a, text)


def _verify_seed(a: dict, text: str) -> None:
    """What the store's id sequence WOULD seed at (R1) — asserted, never written."""
    derived = max(set(a["open_ids"]) | set(a["landed_ids"])) + 1
    header_m = lint.NEXT_ID.search(text)
    header = int(header_m.group(1)) if header_m else None
    seed, detail, ok = None, "", True
    try:
        seed = ledger_store.derive_next_id(text)
    except ledger_store.SeedError as exc:
        ok, detail = False, str(exc)
        _flag(a["conflicts"], "seed verification", id=None, detail=detail)
    max_head = max((i for e in a["entries"] for i in e["ids"]), default=0)
    if ok and seed <= max_head:
        # A stray entry head above the parsed maximum would mint a colliding id.
        ok = False
        detail = f"seed {seed} does not exceed entry-head id #{max_head}"
        _flag(a["conflicts"], "seed verification", id=None, detail=detail)
    if ok:
        detail = f"seed {seed} == MAX(id)+1 and exceeds every existing id"
    a["seed"] = {"header": header, "derived": derived, "seed": seed,
                 "ok": ok, "detail": detail}


def _read_ledger(path: str) -> str:
    try:
        return Path(path).read_text(encoding="utf-8")
    except OSError as exc:
        raise _CliFail(EX_NOINPUT, f"cannot read ledger {path}: {exc}")


class _CliFail(Exception):
    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code, self.message = code, message


EX_NOPERM = 77

# ---------------------------------------------------------------------------
# Import + verify (#294 increment 4). Scratch paths only — never .dreamwork/.
# ---------------------------------------------------------------------------

def _guard_scratch_path(db_path: str) -> None:
    """Refuse any target inside a `.dreamwork/` directory.

    This increment imports to scratch only; the live location is cutover's
    (R4), and a mis-typed `--to` must fail loudly, not populate the real
    store ahead of the freeze.
    """
    if ".dreamwork" in Path(db_path).resolve().parts:
        raise _CliFail(EX_NOPERM, f"refusing --to {db_path}: a path inside "
                       ".dreamwork/ is the live location, not a scratch target")


def _check_importable(a: dict) -> None:
    """Refuse ledgers whose conflicts have no ruled import resolution."""
    fatal = [(cat, rows) for cat in FATAL_CONFLICTS
             if a["conflicts"].get(cat)]
    if fatal:
        detail = "; ".join(f"{cat} ({len(rows)})" for cat, rows in fatal)
        raise _CliFail(EX_DATAERR, "import refused: the ledger carries "
                       f"conflicts with no import resolution — {detail}. "
                       "Resolve them in the ledger first; the dry-run lists "
                       "every one.")


def import_into_db(text: str, a: dict, db_path: str) -> dict:
    """Populate the flat schema at db_path, or no-op over an existing import.

    One transaction (BEGIN IMMEDIATE … COMMIT) holds the whole population, so
    a failed import leaves the scratch untouched. A second import over a DB
    that already has rows populates nothing and relies on verify_db: parity
    is a reported no-op, divergence is a loud refusal (the caller exits
    nonzero on verification failures).
    """
    _guard_scratch_path(db_path)
    _check_importable(a)
    store = ledger_store.open_store(db_path, ledger_text=text)
    rows = expected_tasks(text, a)
    populated = 0
    try:
        have = store.conn.execute("SELECT COUNT(*) FROM task").fetchone()[0]
        if have == 0:
            store.conn.execute("BEGIN IMMEDIATE")
            try:
                # Types first: task.type REFERENCES task_type, and the lookup
                # is deliberately unseeded — the import owns its vocabulary.
                for t in sorted({r["type"] for r in rows.values()
                                 if r["type"] is not None}):
                    store.conn.execute(
                        "INSERT OR IGNORE INTO task_type(type) VALUES (?)", (t,))
                for i in sorted(rows):
                    r = rows[i]
                    store.conn.execute(
                        "INSERT INTO task(id, state, title, body, priority,"
                        " priority_uncertain, type, origin, blocked_on,"
                        " body_digest, source_line)"
                        " VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                        (r["id"], r["state"], r["title"], r["body"],
                         r["priority"], r["priority_uncertain"], r["type"],
                         r["origin"], r["blocked_on"], r["body_digest"],
                         r["source_line"]))
                for x, y in sorted(expected_related(a)):
                    store.conn.execute(
                        "INSERT OR IGNORE INTO related(a, b) VALUES (?, ?)",
                        (x, y))
                for t, n in sorted(expected_depends(a)):
                    store.conn.execute(
                        "INSERT OR IGNORE INTO depends(task, needs)"
                        " VALUES (?, ?)", (t, n))
                store.conn.execute("COMMIT")
                populated = len(rows)
            except Exception:
                store.conn.execute("ROLLBACK")
                raise
        next_id = store.next_id()
    finally:
        store.close()
    want = a["seed"]["seed"]
    if next_id != want:
        raise _CliFail(EX_DATAERR, f"seed drift after import: store next id "
                       f"{next_id} != verified ledger next id {want}")
    return {"populated": populated, "rows": len(rows), "next_id": next_id}


_TASK_COLUMNS = ("state", "title", "body", "priority", "priority_uncertain",
                 "type", "origin", "blocked_on", "body_digest", "source_line")


def verify_db(text: str, a: dict, db_path: str) -> list[str]:
    """Re-read the scratch DB and assert row-for-row parity with the parse.

    Returns the failures, each NAMING the row; empty means parity. Reads
    through its own read-only connection — never the import's — and derives
    expectations from the parse plus the dry-run's reported resolutions, so
    a tampered DB fails here on the DB's contents, not the import's word.
    """
    failures = []
    try:
        conn = sqlite3.connect(f"file:{Path(db_path).resolve()}?mode=ro",
                               uri=True)
    except sqlite3.Error as exc:
        return [f"cannot open scratch DB {db_path}: {exc}"]
    conn.row_factory = sqlite3.Row
    try:
        expected = expected_tasks(text, a)
        rows = conn.execute("SELECT * FROM task").fetchall()
        counts = Counter(r["id"] for r in rows)
        for i, n in sorted(counts.items()):
            if n > 1:
                failures.append(f"task #{i}: present {n} times, expected once")
        db_ids = set(counts)
        for i in sorted(set(expected) - db_ids):
            failures.append(f"task #{i}: missing from the DB")
        for i in sorted(db_ids - set(expected)):
            failures.append(f"task #{i}: in the DB but not in the parse")
        states = Counter(r["state"] for r in rows)
        if states.get("open", 0) != a["open_count"]:
            failures.append(f"open count {states.get('open', 0)} != parse "
                            f"{a['open_count']}")
        if states.get("landed", 0) != a["landed_count"]:
            failures.append(f"landed count {states.get('landed', 0)} != parse "
                            f"{a['landed_count']}")
        by_id = {r["id"]: r for r in rows}
        for i in sorted(set(expected) & db_ids):
            row, want = by_id[i], expected[i]
            for col in _TASK_COLUMNS:
                if row[col] != want[col]:
                    failures.append(
                        f"task #{i}: {col} mismatch — DB has "
                        f"{row[col]!r}, parse expects {want[col]!r}")
        rel = {(r["a"], r["b"]) for r in
               conn.execute("SELECT a, b FROM related")}
        if rel != expected_related(a):
            failures.append(
                f"related pairs diverge — DB-only "
                f"{sorted(rel - expected_related(a))[:3]}, parse-only "
                f"{sorted(expected_related(a) - rel)[:3]}")
        dep = {(r["task"], r["needs"]) for r in
               conn.execute("SELECT task, needs FROM depends")}
        if dep != expected_depends(a):
            failures.append(
                f"depends edges diverge — DB-only "
                f"{sorted(dep - expected_depends(a))[:3]}, parse-only "
                f"{sorted(expected_depends(a) - dep)[:3]}")
        seq_row = conn.execute(
            "SELECT seq FROM sqlite_sequence WHERE name = 'task'").fetchone()
        peak = conn.execute("SELECT MAX(id) FROM task").fetchone()[0]
        want_next = a["seed"]["seed"]
        if seq_row is None or seq_row["seq"] != want_next - 1:
            failures.append(f"id sequence {seq_row['seq'] if seq_row else None}"
                            f" != verified next id {want_next} - 1")
        if peak is not None and peak != want_next - 1:
            failures.append(f"MAX(task.id) {peak} != verified next id "
                            f"{want_next} - 1 — the sequence would mint a "
                            "colliding id")
        failures += _verify_reported_resolutions(a, by_id)
    finally:
        conn.close()
    return failures


def _verify_reported_resolutions(a: dict, by_id: dict) -> list[str]:
    """Bind the DB to the dry-run's WORDS: each reported resolution, checked.

    The import could drift from the dry-run silently if only the replay
    above ran; these assertions read the resolution out of the conflict
    detail itself, so the DB must match what the report SAYS it will do.
    """
    failures = []
    for c in a["conflicts"].get("missing band (P2 by contract)", []):
        row = by_id.get(c["id"])
        if row is not None and (row["priority"], row["priority_uncertain"]) \
                != ("P2", 0):
            failures.append(f"task #{c['id']}: dry-run says imports as P2; "
                            f"DB has {row['priority']!r}")
    for c in a["conflicts"].get("band outside closed set", []):
        m = re.search(r"imports as (P\d+), priority_uncertain=1", c["detail"])
        row = by_id.get(c["id"])
        if m and row is not None and (row["priority"],
                                      row["priority_uncertain"]) \
                != (m.group(1), 1):
            failures.append(f"task #{c['id']}: dry-run says {c['detail']!r}; "
                            f"DB has ({row['priority']!r}, "
                            f"{row['priority_uncertain']})")
    for c in a["conflicts"].get("origin outside closed set", []):
        row = by_id.get(c["id"])
        if row is not None and "imports as unknown" in c["detail"] \
                and row["origin"] != "unknown":
            failures.append(f"task #{c['id']}: dry-run says imports as "
                            f"unknown; DB has {row['origin']!r}")
    return failures


def render_report(a: dict) -> str:
    """The dry-run report — the deliverable of this increment."""
    out = []
    out.append("dreamwork tasks migrate — DRY RUN (writes nothing)")
    out.append(f"ledger: {a['ledger_path']}")
    out.append("")
    out.append("COUNTS")
    out.append(f"  open ids:    {a['open_count']}")
    out.append(f"  landed ids:  {a['landed_count']}")
    out.append(f"  total ids:   {a['total_ids']} "
               f"(disjoint: {'yes' if a['disjoint'] else 'NO — duplicate across sections'})")
    out.append(f"  entries:     {len(a['entries'])}")
    out.append("")
    out.append("ID SET")
    out.append("  " + " ".join(f"#{i}" for i in sorted(set(a['open_ids']) | set(a['landed_ids']))))
    out.append("")
    seed = a["seed"]
    out.append("SEED (R1 — the sequence lives in the store, seeded and verified)")
    out.append(f"  header Next id:  {seed['header'] if seed['header'] is not None else '(absent)'}")
    out.append(f"  MAX(id)+1:       {seed['derived']}")
    out.append(f"  would seed at:   {seed['seed'] if seed['seed'] is not None else '(unverifiable)'}"
               f"  — {'OK: ' if seed['ok'] else 'CONFLICT: '}{seed['detail']}")
    out.append("")
    conflicts = a["conflicts"]
    n = sum(len(v) for v in conflicts.values())
    out.append(f"CONFLICTS ({n}) — output, never errors; exit stays 0 (#346's ruling)")
    if not conflicts:
        out.append("  none")
    for category in sorted(conflicts):
        rows = conflicts[category]
        out.append(f"  {category} ({len(rows)})")
        for r in rows:
            out.append(f"    · {r['detail']}")
    out.append("")
    out.append("DIGESTS (per entry — sha256 of the verbatim body; --import will prove these bytes)")
    for e in a["entries"]:
        label = "/".join(f"#{i}" for i in e["ids"]) if e["ids"] else "(no id)"
        out.append(f"  {label} [{e['section']}] sha256:{e['digest']}")
    return "\n".join(out)


def _run_import(text, analysis, db_path, out) -> int:
    """--import: populate (or no-op), then ALWAYS verify the scratch DB."""
    try:
        result = import_into_db(text, analysis, db_path)
    except _CliFail as exc:
        print(exc.message, file=out)
        return exc.code
    if result["populated"]:
        print(f"imported {result['populated']} task rows into {db_path}",
              file=out)
    else:
        print(f"no-op: {db_path} already holds the import; verifying", file=out)
    print(f"id sequence next id: {result['next_id']} "
          f"(== MAX(id)+1, verified against the ledger)", file=out)
    return _run_verify(text, analysis, db_path, out)


def _run_verify(text, analysis, db_path, out) -> int:
    failures = verify_db(text, analysis, db_path)
    if failures:
        print(f"verification FAILED ({len(failures)}):", file=out)
        for f in failures:
            print(f"  · {f}", file=out)
        return EX_DATAERR
    print("verification OK: scratch DB matches the parse row-for-row",
          file=out)
    return EX_OK


def main(argv=None, out=None) -> int:
    out = out or sys.stdout
    p = _UsageParser(prog="ud-dw-tasks-migrate",
                     description="parse-and-report half of the tasks.md → SQLite migration (#294)")
    p.add_argument("--dry-run", action="store_true",
                   help="parse + report; writes nothing")
    p.add_argument("--import", dest="import_", action="store_true",
                   help="populate a SCRATCH database (never .dreamwork/) and verify it")
    p.add_argument("--verify", action="store_true",
                   help="re-verify an existing scratch database against the parse")
    p.add_argument("--to", metavar="PATH",
                   help="scratch database path for --import/--verify")
    p.add_argument("--ledger", default=".dreamwork/tasks.md",
                   help="path to the Markdown task ledger")
    p.add_argument("--report", metavar="PATH",
                   help="also write the full report to PATH")
    args = p.parse_args(argv)
    if (args.import_ or args.verify) and not args.to:
        p.error("--import/--verify require --to <scratch.db>")
    try:
        text = _read_ledger(args.ledger)
        analysis = build_analysis(text, ledger_path=args.ledger)
    except _Unparseable as exc:
        print(f"unparseable ledger: {exc}", file=out)
        return EX_DATAERR
    except _CliFail as exc:
        print(exc.message, file=out)
        return exc.code
    if args.import_:
        return _run_import(text, analysis, args.to, out)
    if args.verify:
        return _run_verify(text, analysis, args.to, out)
    report = render_report(analysis)
    print(report, file=out)
    if args.report:
        Path(args.report).write_text(report + "\n", encoding="utf-8")
    return EX_OK


if __name__ == "__main__":
    sys.exit(main())
