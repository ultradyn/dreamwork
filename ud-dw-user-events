#!/usr/bin/env python3
"""ud-dw-user-events — bounded projection over the durable user-event journal.

The only human/LLM-facing surface on the journal (design
.dreamwork/docs/plans/user-event-journal.md §"Bounded CLI"). ``list``/``show``/
``health`` are bounded read-only projections that never touch a managed domain
file; only ``replay``/``purge`` may cause a domain effect.

Stable exit codes (asserted by test_user_events_cli.py):

    0   EX_OK         success
    64  EX_USAGE      unknown command / bad arguments
    66  EX_NOINPUT    journal not found / receipt not found
    70  EX_SOFTWARE   internal error

Reads the journal schema directly. Lane B owns ``user_events/sqlite.py`` and
does not yet expose ``list()``/``get()``; the CLI's read queries live here until
it does, and that coupling is reported. Never edit ``user_events/`` — two lanes
in one module is the split brain this repo's ownership rule exists to prevent.

Usage: ud-dw-user-events <command> [options]
  list   --status <s,s> --after <sec> --limit <n>   bounded receipt projection
  show   <receipt> --max-bytes <n>                   the only exact-bytes path
  health                                            recovery path per failure semantic
  replay --limit <n>                                the only command that may mutate
"""
from __future__ import annotations

import argparse
import json
import sqlite3
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from types import SimpleNamespace

# --- Stable exit codes (documented above; asserted by the test) ---
EX_OK = 0
EX_USAGE = 64
EX_NOINPUT = 66
EX_SOFTWARE = 70

COMMANDS = ("list", "show", "health", "replay", "purge")

# Read-only classification: the dispatcher routes read commands to the read
# path (read-only journal handle, never a managed file) and consults
# `_write_authorized` before any write-capable code runs. `replay`/`purge` are
# the only commands permitted a domain effect; widening `_write_authorized` is
# the F3 red line (a read command must never be write-authorized).
READ_COMMANDS = frozenset({"list", "show", "health"})
WRITE_COMMANDS = frozenset({"replay", "purge"})
_HELP = __doc__


def _write_authorized(command: str) -> bool:
    """The read-only guard. True only for commands permitted a domain effect."""
    return command in WRITE_COMMANDS


# health: every failure semantic in the design (user-event-journal.md
# §"Failure semantics") has a named recovery path here. Keys are the pre-colon
# phrase of each bullet in that section, parsed by the F4 test; if the parse
# silently finds nothing the coverage check would pass vacuously, so the test
# asserts a plausible parsed count first (the lessons.md:1447 shape).
HEALTH_ROWS = {
    "Journal open/transaction/fsync failure": (
        "no 202; the client attempt remains. Recovery: inspect the journal "
        "path/permissions; no receipt was committed, so retry is safe."),
    "Busy timeout": (
        "retriable 503; no receipt unless the receive transaction committed. "
        "Recovery: retry with backoff; a committed receipt is idempotent."),
    "Shadow failure": (
        "still 202; health reports shadow_failed against the durable receipt. "
        "Recovery: the receipt stands; re-emit the shadow when able."),
    "JSON/schema/domain validation error after a registered complete envelope": (
        "received -> rejected without claim, with a bounded reason code. "
        "Recovery: correct the payload and resend with a NEW client_action_id."),
    "Transient domain I/O": (
        "retryable; exact receipt and claim history preserved. Recovery: the "
        "lease expires and the consumer retries the bounded write."),
    "Ambiguous/torn domain": (
        "recovering; no mutation until an operator resolves. Recovery: "
        "rebaseline or discard the torn file, then replay from the cursor."),
    "Consumer crash": (
        "lease expiry + ternary proof; never start from latest time. Recovery: "
        "reclaim the expired lease; proof decides apply/no-op/unknown."),
    "Corrupt journal": (
        "fail closed; preserve files; health explains the recovery path. "
        "Recovery: rebuild the chain from ordinal 1 or restore from backup; "
        "never recreate over the only authority."),
}


class _CliError(Exception):
    """An expected failure with a stable exit code; caught by main()."""

    def __init__(self, exit_code: int, message: str):
        super().__init__(message)
        self.exit_code = exit_code
        self.message = message


def _open_ro(journal_path):
    """Open the journal read-only.

    ``PRAGMA query_only=ON`` refuses every write on this handle, so a read
    command physically cannot mutate the journal — the read-only property is
    enforced by SQLite, not by a convention a later edit could forget.
    """
    p = Path(journal_path)
    if not p.is_file():
        raise _CliError(EX_NOINPUT, f"journal not found: {p}")
    try:
        conn = sqlite3.connect(str(p))
    except sqlite3.Error as e:
        raise _CliError(EX_SOFTWARE, f"cannot open journal: {e}")
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA query_only=ON")
    conn.execute("PRAGMA busy_timeout=5000")
    return conn


def cmd_list(args, ctx, out):
    """Bounded projection of receipts as JSONL (or a simple table)."""
    conn = _open_ro(ctx.journal)
    where = []
    params: list = []
    if args.status:
        statuses = [s.strip() for s in args.status.split(",") if s.strip()]
        if statuses:
            where.append("state IN (%s)" % ",".join("?" for _ in statuses))
            params.extend(statuses)
    if args.after:
        cutoff = (
            datetime.now(timezone.utc) - timedelta(seconds=args.after)
        ).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
        where.append("received_at > ?")
        params.append(cutoff)
    where_sql = (" WHERE " + " AND ".join(where)) if where else ""
    # --- F1 red line: the LIMIT ? bind bounds the projection. ---
    # A test that only checks field presence passes with this deleted, so the
    # bounded test asserts the ROW COUNT against a fixture derived at runtime
    # and asserted to exceed the limit.
    sql = (
        "SELECT receipt_id, sequence, endpoint, received_at, request_digest, "
        "state, payload_size FROM receipts"
        + where_sql
        + " ORDER BY sequence DESC LIMIT ?"
    )
    params.append(args.limit)
    try:
        rows = conn.execute(sql, params).fetchall()
    finally:
        conn.close()
    if ctx.format == "table":
        cols = ("sequence", "state", "endpoint", "time", "digest", "payload_size")
        out.write("\t".join(cols) + "\n")
        for r in rows:
            out.write("\t".join([
                str(r["sequence"]), str(r["state"]), str(r["endpoint"]),
                str(r["received_at"]), str(r["request_digest"]),
                str(r["payload_size"]),
            ]) + "\n")
        return EX_OK
    for r in rows:
        rec = {
            "id": r["receipt_id"],
            "sequence": r["sequence"],
            "endpoint": r["endpoint"],
            "time": r["received_at"],
            "digest": r["request_digest"],
            "state": r["state"],
            "payload_size": r["payload_size"],
        }
        out.write(json.dumps(rec) + "\n")
    return EX_OK


def _resolve_journal(args) -> str:
    if getattr(args, "journal", None):
        return args.journal
    return str(Path(args.target) / ".dreamwork" / "user-events.sqlite3")


def _as_int(value) -> int:
    """Parse an int, or return -1 (no receipt has a negative sequence)."""
    try:
        return int(value)
    except (TypeError, ValueError):
        return -1


def cmd_show(args, ctx, out):
    """The only exact-bytes path. Truncation reports original length + digest.

    ``--max-bytes`` bounds what is shown; when the payload exceeds it, the
    response says so by carrying the ORIGINAL length and the request digest, so
    a reader knows exactly what was elided and can re-fetch or verify later.
    """
    conn = _open_ro(ctx.journal)
    try:
        row = conn.execute(
            "SELECT receipt_id, sequence, endpoint, received_at, request_digest, "
            "content_type, exact_payload_bytes, payload_size, state "
            "FROM receipts WHERE receipt_id = ? OR sequence = ?",
            (args.receipt, _as_int(args.receipt)),
        ).fetchone()
    finally:
        conn.close()
    if row is None:
        raise _CliError(EX_NOINPUT, f"no receipt matching {args.receipt!r}")
    body = bytes(row["exact_payload_bytes"])
    original_length = int(row["payload_size"])
    digest = row["request_digest"]
    max_bytes = args.max_bytes
    rec = {
        "id": row["receipt_id"],
        "sequence": row["sequence"],
        "endpoint": row["endpoint"],
        "state": row["state"],
        "content_type": row["content_type"],
        "max_bytes": max_bytes,
    }
    if len(body) > max_bytes:
        # --- F2 red line: the truncation-metadata emit ---
        # Deleting these two fields is the red: the test asserts both are
        # present and correct when the payload exceeds --max-bytes, so a
        # silent elision (truncated with no record of what was dropped) fails.
        rec["truncated"] = True
        rec["original_length"] = original_length
        rec["digest"] = digest
        rec["payload"] = body[:max_bytes].decode("utf-8", errors="replace")
    else:
        rec["truncated"] = False
        rec["original_length"] = len(body)
        rec["payload"] = body.decode("utf-8", errors="replace")
    out.write(json.dumps(rec) + "\n")
    return EX_OK


def cmd_replay(args, ctx, out):
    """The only write-authorized command. Domain effects are NOT implemented:
    lane D's application adapters (#19) are not built, so replay is permitted
    but applies nothing. It says so honestly rather than pretending an effect."""
    out.write(json.dumps({
        "replay": "not_implemented",
        "reason": "no application adapters registered (lane D #19 not built)",
        "applied": 0,
    }) + "\n")
    return EX_OK


def cmd_purge(args, ctx, out):
    """Refused. Purge is an operator-only script and is NOT authorised under
    this plan (the approval clause excludes payload purge; design §Retention).
    It is classified write-capable so the guard knows, but never enabled."""
    raise _CliError(
        EX_SOFTWARE,
        "purge is not authorised under this plan (operator-only; see "
        "user-event-journal.md §Retention and scripted purge)",
    )


def cmd_health(args, ctx, out):
    """A recovery path for every failure semantic the design lists.

    Emits one JSONL row per semantic: {"semantic": ..., "recovery": ...}. The
    F4 test parses the design's §"Failure semantics" list and asserts each has
    a row here — and that the parse found a plausible count, so a parser that
    silently finds nothing fails loudly rather than passing vacuously.
    """
    for semantic, recovery in HEALTH_ROWS.items():
        out.write(json.dumps({"semantic": semantic, "recovery": recovery}) + "\n")
    return EX_OK


def _print_top_help(out) -> None:
    out.write(_HELP)
    if not _HELP.endswith("\n"):
        out.write("\n")


def _command_parser(command: str) -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=f"ud-dw-user-events {command}", add_help=True
    )
    p.add_argument("--journal", default=None,
                   help="journal db path (default: <target>/.dreamwork/user-events.sqlite3)")
    p.add_argument("--target", default=".", help="managed-domain target dir")
    p.add_argument("--format", choices=("jsonl", "table"), default="jsonl")
    if command == "list":
        p.add_argument("--status", help="comma-separated receipt states to filter")
        p.add_argument("--after", type=int, help="only receipts newer than N seconds ago")
        p.add_argument("--limit", type=int, default=20, help="max rows (default 20)")
    elif command == "show":
        p.add_argument("receipt", help="receipt id or sequence number")
        p.add_argument("--max-bytes", type=int, default=4096, dest="max_bytes",
                       help="bound on exact bytes shown (default 4096)")
    elif command == "replay":
        p.add_argument("--limit", type=int, default=20, help="max receipts to replay")
    return p


def main(argv=None, out=None) -> int:
    """Dispatch one command. Returns a stable exit code; never raises SystemExit."""
    if argv is None:
        argv = sys.argv[1:]
    if out is None:
        out = sys.stdout
    if not argv:
        _print_top_help(out)
        return EX_USAGE
    if argv[0] in ("-h", "--help", "help"):
        _print_top_help(out)
        return EX_OK
    command, rest = argv[0], argv[1:]
    if command not in COMMANDS:
        print(
            f"ud-dw-user-events: unknown command {command!r}\n"
            f"commands: {', '.join(COMMANDS)}",
            file=sys.stderr,
        )
        return EX_USAGE
    parser = _command_parser(command)
    try:
        args = parser.parse_args(rest)
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else EX_USAGE
        return EX_OK if code == 0 else EX_USAGE
    ctx = SimpleNamespace(
        journal=_resolve_journal(args), target=args.target, format=args.format
    )
    try:
        if command in READ_COMMANDS:
            if command == "list":
                return cmd_list(args, ctx, out)
            if command == "show":
                return cmd_show(args, ctx, out)
            if command == "health":
                return cmd_health(args, ctx, out)
            return EX_USAGE
        # The read-only guard: only write-authorized commands reach the write
        # path. Deleting/widening `_write_authorized` is the F3 red line.
        if _write_authorized(command):
            if command == "replay":
                return cmd_replay(args, ctx, out)
            if command == "purge":
                return cmd_purge(args, ctx, out)
        return EX_USAGE  # unknown command slipped past the COMMANDS gate
    except _CliError as e:
        print(e.message, file=sys.stderr)
        return e.exit_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
