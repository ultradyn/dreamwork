def _guard_scratch_path(db_path: str) -> None:
    """Refuse any target inside a `.dreamwork/` directory.

    This increment imports to scratch only; the live location is cutover's
    (R4), and a mis-typed `--to` must fail loudly, not populate the real
    store ahead of the freeze.
    """
    if ".dreamwork" in Path(db_path).resolve().parts:
        raise _CliFail(EX_NOPERM, f"refusing --to {db_path}: a path inside "
                       ".dreamwork/ is the live location, not a scratch target")


def _check_importable(a: dict) -> None:
    """Refuse ledgers whose conflicts have no ruled import resolution."""
    fatal = [(cat, a["conflicts"][cat]) for cat in FATAL_CONFLICTS
             if a["conflicts"].get(cat)]
    if fatal:
        detail = "; ".join(f"{cat} ({len(rows)})" for cat, rows in fatal)
        raise _CliFail(EX_DATAERR, "import refused: the ledger carries "
                       f"conflicts with no import resolution — {detail}. "
                       "Resolve them in the ledger first; the dry-run lists "
                       "every one.")


def _populate_store(conn: sqlite3.Connection, text: str, a: dict) -> int:
    """Populate the flat schema on an existing connection. Returns the row
    count populated (0 if already populated). Caller owns the store lifecycle.

    Extracted from ``import_into_db`` so the cutover can populate under its
    lease on the same connection (one truth, one txn). One ``BEGIN IMMEDIATE
    … COMMIT`` holds the whole population, so a failed import leaves the DB
    untouched.
    """
    rows = expected_tasks(text, a)
    have = conn.execute("SELECT COUNT(*) FROM task").fetchone()[0]
    if have > 0:
        return 0
    conn.execute("BEGIN IMMEDIATE")
    try:
        # Types first: task.type REFERENCES task_type, and the lookup
        # is deliberately unseeded — the import owns its vocabulary.
        for t in sorted({r["type"] for r in rows.values()
                         if r["type"] is not None}):
            conn.execute(
                "INSERT OR IGNORE INTO task_type(type) VALUES (?)", (t,))
        for i in sorted(rows):
            r = rows[i]
            conn.execute(
                "INSERT INTO task(id, state, title, body, priority,"
                " priority_uncertain, type, origin, blocked_on,"
                " body_digest, source_line)"
                " VALUES (?,?,?,?,?,?,?,?,?,?,?)",
                (r["id"], r["state"], r["title"], r["body"],
                 r["priority"], r["priority_uncertain"], r["type"],
                 r["origin"], r["blocked_on"], r["body_digest"],
                 r["source_line"]))
        for x, y in sorted(expected_related(a)):
            conn.execute(
                "INSERT OR IGNORE INTO related(a, b) VALUES (?, ?)",
                (x, y))
        for t, n in sorted(expected_depends(a)):
            conn.execute(
                "INSERT OR IGNORE INTO depends(task, needs)"
                " VALUES (?, ?)", (t, n))
        conn.execute("COMMIT")
    except Exception:
        conn.execute("ROLLBACK")
        raise
    return len(rows)


def _insert_groomed_rows(conn: sqlite3.Connection, tasks: dict) -> int:
    """Write recovered groomed-id task rows on a connection (INSERT OR IGNORE).

    Extracted from ``import_history_into_db`` so the cutover can write groomed
    rows under its lease on the same connection it populated current-entry
    rows on — the same extraction discipline ``_populate_store`` followed.
    Caller owns the transaction. ``INSERT OR IGNORE`` keeps it idempotent
    over a re-run (rollback re-runs forward). Types are registered first
    (task.type REFERENCES task_type, unseeded — the import owns vocabulary).
    """
    for t in sorted({r["type"] for r in tasks.values()
                     if r["type"] is not None}):
        conn.execute("INSERT OR IGNORE INTO task_type(type) VALUES (?)", (t,))
    for i in sorted(tasks):
        r = tasks[i]
        conn.execute(
            "INSERT OR IGNORE INTO task(id, state, title, body,"
            " priority, priority_uncertain, type, origin,"
            " blocked_on, body_digest, source_line)"
            " VALUES (?,?,?,?,?,?,?,?,?,?,?)",
            (r["id"], r["state"], r["title"], r["body"],
             r["priority"], r["priority_uncertain"], r["type"],
             r["origin"], r["blocked_on"], r["body_digest"],
             r["source_line"]))
    return len(tasks)


def _populate_events(conn: sqlite3.Connection, events: list) -> int:
    """Write chained migration:git events on a connection; idempotent.

    Connection-level companion to ``_populate_store`` / ``_insert_groomed_rows``
    so the cutover can write first-sight events under its lease on the same
    connection (#294 inc 8). Idempotent: a no-op if migration:git events
    already exist (a re-run after rollback, or a DB that already ran
    --import-history). Caller owns the transaction; events are chained via
    ``chain_events`` and inserted in chain order so ``ordinal`` follows the
    chain.
    """
    have = conn.execute(
        "SELECT COUNT(*) FROM task_event WHERE actor = 'migration:git'"
    ).fetchone()[0]
    if have > 0 or not events:
        return 0
    for e in chain_events(events):
        conn.execute(
            "INSERT INTO task_event(task_id, at, cause, from_state,"
            " to_state, actor, receipt_id, detail, prev_hash, hash)"
            " VALUES (?,?,?,?,?,?,?,?,?,?)",
            (e["task_id"], e["at"], e["cause"], e["from_state"],
             e["to_state"], e["actor"], e["receipt_id"], e["detail"],
             e["prev_hash"], e["hash"]))
    return len(events)


def import_into_db(text: str, a: dict, db_path: str) -> dict:
    """Populate the flat schema at db_path, or no-op over an existing import.

    One transaction (BEGIN IMMEDIATE … COMMIT) holds the whole population, so
    a failed import leaves the scratch untouched. A second import over a DB
    that already has rows populates nothing and relies on verify_db: parity
    is a reported no-op, divergence is a loud refusal (the caller exits
    nonzero on verification failures).
    """
    _guard_scratch_path(db_path)
    _check_importable(a)
    store = ledger_store.open_store(db_path, ledger_text=text)
    try:
        populated = _populate_store(store.conn, text, a)
        next_id = store.next_id()
    finally:
        store.close()
    want = a["seed"]["seed"]
    if next_id != want:
        raise _CliFail(EX_DATAERR, f"seed drift after import: store next id "
                       f"{next_id} != verified ledger next id {want}")
    return {"populated": populated, "rows": len(expected_tasks(text, a)),
            "next_id": next_id}


def import_history_into_db(text: str, a: dict, db_path: str, snapshots) -> dict:
    """Populate groomed-id rows + synthetic migration:git events (R3).

    Scratch-only (``_guard_scratch_path``). Idempotent: a DB that already
    holds migration:git events is a no-op. The recovered task rows share the
    verbatim schema (body/title NOT NULL from a real history body; an id with
    no entry head in any commit is UNRECOVERABLE and gets no row). Events are
    hash-chained (``chain_events``) and inserted in chain order, so
    ``ordinal`` follows the chain.
    """
    _guard_scratch_path(db_path)
    rec = recover_groomed_history(a, snapshots)
    store = ledger_store.open_store(db_path, ledger_text=text)
    populated = False
    try:
        have_events = store.conn.execute(
            "SELECT COUNT(*) FROM task_event WHERE actor = 'migration:git'"
        ).fetchone()[0]
        if have_events == 0 and rec["events"]:
            populated = True
            store.conn.execute("BEGIN IMMEDIATE")
            try:
                _insert_groomed_rows(store.conn, rec["tasks"])
                _populate_events(store.conn, rec["events"])
                store.conn.execute("COMMIT")
            except Exception:
                store.conn.execute("ROLLBACK")
                raise
        n_events = store.conn.execute("SELECT COUNT(*) FROM task_event").fetchone()[0]
        n_rows = store.conn.execute("SELECT COUNT(*) FROM task").fetchone()[0]
    finally:
        store.close()
    return {"recovered": len(rec["tasks"]),
            "unrecoverable": sorted(rec["unrecoverable"]),
            "events": len(rec["events"]), "task_rows": n_rows,
            "event_rows": n_events, "populated": populated}


_TASK_COLUMNS = ("state", "title", "body", "priority", "priority_uncertain",
                 "type", "origin", "blocked_on", "body_digest", "source_line")


def verify_db(text: str, a: dict, db_path: str, snapshots_fn=None) -> list[str]:
    """Re-read the scratch DB and assert row-for-row parity with the parse.

    Returns the failures, each NAMING the row; empty means parity. Reads
    through its own read-only connection — never the import's — and derives
    expectations from the parse plus the dry-run's reported resolutions, so
    a tampered DB fails here on the DB's contents, not the import's word.

    Post-R3, groomed ids may LEGITIMATELY hold a row (history-imported); the
    verbatim row-set checks exclude them and ``_verify_history`` owns them: a
    groomed row must be backed by ``migration:git`` events, the event chain
    must recompute from genesis, and (when git snapshots are available) each
    backed row must match the recovered body. A groomed row with NO backing
    events is fabrication — the pre-R3 rule, still live.
    """
    failures = []
    try:
        conn = sqlite3.connect(f"file:{Path(db_path).resolve()}?mode=ro",
                               uri=True)
    except sqlite3.Error as exc:
        return [f"cannot open scratch DB {db_path}: {exc}"]
    conn.row_factory = sqlite3.Row
    try:
        expected = expected_tasks(text, a)
        rows = conn.execute("SELECT * FROM task").fetchall()
        counts = Counter(r["id"] for r in rows)
        for i, n in sorted(counts.items()):
            if n > 1:
                failures.append(f"task #{i}: present {n} times, expected once")
        db_ids = set(counts)
        groomed = {c["id"] for c in
                   a["conflicts"].get("section id without an entry", [])}
        verbatim_db = db_ids - groomed  # history-backed groomed rows excluded
        for i in sorted(set(expected) - verbatim_db):
            failures.append(f"task #{i}: missing from the DB")
        for i in sorted(verbatim_db - set(expected)):
            failures.append(f"task #{i}: in the DB but not in the parse")
        verbatim_rows = [r for r in rows if r["id"] not in groomed]
        states = Counter(r["state"] for r in verbatim_rows)
        want_states = Counter(r["state"] for r in expected.values())
        for state in ("open", "landed"):
            if states.get(state, 0) != want_states.get(state, 0):
                failures.append(f"{state} count {states.get(state, 0)} != "
                                f"parse {want_states.get(state, 0)}")
        by_id = {r["id"]: r for r in rows}
        for i in sorted(set(expected) & verbatim_db):
            row, want = by_id[i], expected[i]
            for col in _TASK_COLUMNS:
                if row[col] != want[col]:
                    failures.append(
                        f"task #{i}: {col} mismatch — DB has "
                        f"{row[col]!r}, parse expects {want[col]!r}")
        failures += _verify_history(a, conn, db_ids, snapshots_fn)
        rel = {(r["a"], r["b"]) for r in
               conn.execute("SELECT a, b FROM related")}
        if rel != expected_related(a):
            failures.append(
                f"related pairs diverge — DB-only "
                f"{sorted(rel - expected_related(a))[:3]}, parse-only "
                f"{sorted(expected_related(a) - rel)[:3]}")
        dep = {(r["task"], r["needs"]) for r in
               conn.execute("SELECT task, needs FROM depends")}
        if dep != expected_depends(a):
            failures.append(
                f"depends edges diverge — DB-only "
                f"{sorted(dep - expected_depends(a))[:3]}, parse-only "
                f"{sorted(expected_depends(a) - dep)[:3]}")
        seq_row = conn.execute(
            "SELECT seq FROM sqlite_sequence WHERE name = 'task'").fetchone()
        peak = conn.execute("SELECT MAX(id) FROM task").fetchone()[0]
        want_next = a["seed"]["seed"]
        if seq_row is None or seq_row["seq"] != want_next - 1:
            failures.append(f"id sequence {seq_row['seq'] if seq_row else None}"
                            f" != verified next id {want_next} - 1")
        if peak is not None and peak != want_next - 1:
            failures.append(f"MAX(task.id) {peak} != verified next id "
                            f"{want_next} - 1 — the sequence would mint a "
                            "colliding id")
        failures += _verify_reported_resolutions(a, by_id)
    finally:
        conn.close()
    return failures


def _verify_history(a, conn, db_ids, snapshots_fn) -> list:
    """Post-R3 groomed-id + event-chain consistency (R3, #294 increment 5).

    (1) a groomed id with a row but no ``migration:git`` event is fabrication
        — the pre-R3 rule, still live (a row the history import did not back
        is a body invented out of thin air);
    (2) the ``task_event`` chain recomputes from genesis over every row
        ordered by ordinal (self-contained — needs no git);
    (3) when git snapshots are available AND events exist (history imported),
        each backed row must match the recovered body, and no recoverable id
        may be missing its row.
    """
    failures = []
    groomed = {c["id"] for c in
               a["conflicts"].get("section id without an entry", [])}
    backed = {r["task_id"] for r in conn.execute(
        "SELECT task_id FROM task_event WHERE actor = 'migration:git'")}
    for i in sorted(groomed & db_ids):
        if i not in backed:
            failures.append(
                f"task #{i}: groomed id has a row with no migration:git "
                "event backing it — that row is a fabrication")
    all_ev = conn.execute(
        "SELECT * FROM task_event ORDER BY ordinal").fetchall()
    prev = genesis_hash()
    for r in all_ev:
        d = dict(r)
        if r["prev_hash"] != prev:
            failures.append(f"task_event ordinal {r['ordinal']}: prev_hash "
                            f"breaks the chain (expected {prev[:12]}…)")
        if r["hash"] != hash_event(prev, canonical_event_bytes(d)):
            failures.append(f"task_event ordinal {r['ordinal']}: hash does "
                            "not recompute from prev + canonical bytes")
        prev = r["hash"]
    if snapshots_fn is not None and all_ev:
        rec = recover_groomed_history(a, snapshots_fn())
        want = rec["tasks"]
        for i in sorted(want):
            if i not in db_ids:
                failures.append(f"task #{i}: recoverable groomed id has no "
                                "row — the history import is incomplete")
        by_id = {r["id"]: r for r in
                 conn.execute("SELECT * FROM task").fetchall()}
        for i in sorted(set(want) & db_ids):
            row, exp = by_id[i], want[i]
            for col in _TASK_COLUMNS:
                if col == "source_line":
                    continue  # history rows have no current-ledger line
                if row[col] != exp[col]:
                    failures.append(f"task #{i}: {col} mismatch — DB has "
                                    f"{row[col]!r}, history recovers "
                                    f"{exp[col]!r}")
    return failures


def _verify_reported_resolutions(a: dict, by_id: dict) -> list[str]:
    """Bind the DB to the dry-run's WORDS: each reported resolution, checked.

    The import could drift from the dry-run silently if only the replay
    above ran; these assertions read the resolution out of the conflict
    detail itself, so the DB must match what the report SAYS it will do.
    """
    failures = []
    for c in a["conflicts"].get("missing band (P2 by contract)", []):
        row = by_id.get(c["id"])
        if row is not None and (row["priority"], row["priority_uncertain"]) \
                != ("P2", 0):
            failures.append(f"task #{c['id']}: dry-run says imports as P2; "
                            f"DB has {row['priority']!r}")
    for c in a["conflicts"].get("band outside closed set", []):
        m = re.search(r"imports as (P\d+), priority_uncertain=1", c["detail"])
        row = by_id.get(c["id"])
        if m and row is not None and (row["priority"],
                                      row["priority_uncertain"]) \
                != (m.group(1), 1):
            failures.append(f"task #{c['id']}: dry-run says {c['detail']!r}; "
                            f"DB has ({row['priority']!r}, "
                            f"{row['priority_uncertain']})")
    for c in a["conflicts"].get("origin outside closed set", []):
        row = by_id.get(c["id"])
        if row is not None and "imports as unknown" in c["detail"] \
                and row["origin"] != "unknown":
            failures.append(f"task #{c['id']}: dry-run says imports as "
                            f"unknown; DB has {row['origin']!r}")
    return failures


# ---------------------------------------------------------------------------
# Git-history recovery + synthetic events (R3, #294 increment 5).
# ---------------------------------------------------------------------------
# R3's ruling (05:48): git history imports as synthetic first-sight events
# attributed actor='migration:git' — NEVER to the human or the loop — so a
# reconstructed event is always distinguishable from a witnessed one. The 74
# "section id without an entry" ids (a bold `**#N**` span in groomed landed
# prose, no entry head in the current file) get a task row here ONLY when a
# verbatim body is recovered from history; body/title are NOT NULL and a
# stub would be fabrication. An id that never had an entry head in any
# commit is honestly UNRECOVERABLE and gets no row (reported, not invented).

def git_snapshots(ledger_path: str = ".dreamwork/tasks.md"):
    """Chronological ``(sha, epoch, ledger_text)`` for every commit touching
    the ledger. Pure over git's deterministic ``log --reverse`` order; the
    same history always yields the same sequence. ``ledger_path`` may be
    absolute or relative; ``git show <sha>:<path>`` needs the repo-root-
    relative form, derived here from ``git rev-parse --show-toplevel``."""
    top = Path(subprocess.check_output(
        ["git", "rev-parse", "--show-toplevel"], text=True).strip())
    rel = str(Path(ledger_path).resolve().relative_to(top))
    raw = subprocess.check_output(
        ["git", "log", "--reverse", "--format=%H %ct", "--", rel],
        stderr=subprocess.DEVNULL, text=True)
    out = []
    for line in raw.splitlines():
        sha, ct = line.split()
        blob = subprocess.check_output(
            ["git", "show", f"{sha}:{rel}"], stderr=subprocess.DEVNULL)
        out.append((sha, int(ct), blob.decode("utf-8", "replace")))
    return out


def _safe_snapshots(ledger_path: str) -> list:
    """``git_snapshots`` that returns ``[]`` when there is no git history.

    The cutover (and rollback, which re-runs forward) needs first-sight
    events for the burndown to survive the flip. In a live cutover the
    target IS a git checkout, so the walk runs; on a scratch target with no
    git history (the cutover tests' plain tmp dir), there are no snapshots,
    so no events are fabricated — the same honesty rule as an unrecoverable
    groomed id (no first-sight, no event).
    """
    try:
        return git_snapshots(ledger_path)
    except (subprocess.CalledProcessError, OSError, FileNotFoundError,
            sqlite3.Error, ValueError):
        return []


def _length_framed(*parts) -> bytes:
    """8-byte big-endian length prefix per part (journal contract; matches
    user_events.digest.length_framed so the framing cannot drift)."""
    out = bytearray()
    for part in parts:
        data = part.encode("utf-8") if isinstance(part, str) else bytes(part)
        out.extend(len(data).to_bytes(8, "big"))
        out.extend(data)
    return bytes(out)


def genesis_hash() -> str:
    """H_0 = SHA-256(journal_id || schema_version) — the task-event chain seed."""
    return hashlib.sha256(
        f"ud-dreamwork.task-ledger{ledger_store.SCHEMA_VERSION}".encode()).hexdigest()


def canonical_event_bytes(e: dict) -> bytes:
    """``length_framed(canonical_event)`` — the stable fields, never the hash."""
    return _length_framed(str(e["task_id"]), e["at"], e["cause"],
                          e["from_state"] or "", e["to_state"] or "",
                          e["actor"], e.get("detail") or "")


def hash_event(prev_hash: str, canonical: bytes) -> str:
    """H_i = SHA-256(domain_tag || H_(i-1) || length_framed(canonical_event_i)).

    DOMAIN_TAG comes from ledger_store (the table's own tag); prev_hash is
    load-bearing (B3): drop it and an earlier mutation stops moving the head.
    """
    return hashlib.sha256(
        ledger_store.DOMAIN_TAG + prev_hash.encode("ascii") + canonical).hexdigest()


def chain_events(events: list) -> list:
    """Order events deterministically and append prev_hash/hash per the chain.

    Order is ``(at, task_id, rank)`` with first-sight (from_state is None)
    before landed, so the same history always produces the same chain.
    """
    ordered = sorted(events, key=lambda e: (
        e["at"], e["task_id"], 0 if e["from_state"] is None else 1))
    prev, chained = genesis_hash(), []
    for e in ordered:
        h = hash_event(prev, canonical_event_bytes(e))
        chained.append({**e, "prev_hash": prev, "hash": h})
        prev = h
    return chained


def _history_event(task_id, epoch, from_state, to_state, sha, kind) -> dict:
    """One synthetic migration:git lifecycle event reconstructed from history."""
    at = datetime.fromtimestamp(epoch, tz=timezone.utc).isoformat()
    return {"task_id": task_id, "at": at, "cause": "migration_git",
            "from_state": from_state, "to_state": to_state,
            "actor": "migration:git", "receipt_id": None,
            "detail": f"reconstructed {kind} from git history ({sha[:12]})"}


def recover_groomed_history(a: dict, snapshots: list) -> dict:
    """Recover bodies + lifecycle for groomed ids from chronological snapshots.

    Pure: no git, no DB. ``snapshots`` is the chronological ``(sha, epoch,
    text)`` list. Returns ``{tasks, events, unrecoverable, groomed}`` where
    tasks/events are UNCHAINED (call ``chain_events`` for the hash field).
    A groomed id with no entry head in any commit is unrecoverable: no row,
    no event, reported honestly (body is NOT NULL and a stub is fabrication).
    """
    watch = _load_watch_or_die()
    groomed = {c["id"] for c in
               a["conflicts"].get("section id without an entry", [])}
    first, last_body, landed, prev_sec = {}, {}, {}, {}
    for sha, epoch, text in snapshots:
        o, l = watch.parse_ledger(text)
        oids, lids = {int(x) for x in o}, {int(x) for x in l}
        heads = {i: body for ids, body in
                 ledger_parse.ledger_entries(text) for i in ids}
        for i in groomed:
            sec = "open" if i in oids else ("landed" if i in lids else None)
            if i not in first and (sec is not None or i in heads):
                first[i] = (sha, epoch, sec)
            if i in heads:                       # keeps updating → last version
                last_body[i] = (heads[i], sha, epoch)
            if prev_sec.get(i) == "open" and sec == "landed" and i not in landed:
                landed[i] = (sha, epoch)
            if sec is not None:
                prev_sec[i] = sec
    cur_open = set(a["open_ids"])
    tasks, events, unrecoverable = {}, [], set()
    for i in sorted(groomed):
        if i not in last_body:
            unrecoverable.add(i)
            continue
        body, _, _ = last_body[i]
        band, unc = entry_band(body)
        tasks[i] = {
            "id": i, "state": "open" if i in cur_open else "landed",
            "title": head_title(body), "body": body,
            "priority": band, "priority_uncertain": unc,
            "type": entry_type(body), "origin": entry_origin([i], body),
            "blocked_on": blocked_on_text(body),
            "body_digest": hashlib.sha256(body.encode()).hexdigest(),
            "source_line": None,
        }
        fsha, fepoch, fsec = first[i]
        events.append(_history_event(i, fepoch, None, fsec or "open", fsha,
                                     "first sight"))
        if i in landed:
            lsha, lepoch = landed[i]
            events.append(_history_event(i, lepoch, "open", "landed", lsha,
                                         "landed"))
    return {"tasks": tasks, "events": events,
            "unrecoverable": unrecoverable, "groomed": groomed}


def first_sight_events(a: dict, snapshots: list) -> list:
    """First-sight ARRIVAL + LANDED events for EVERY id visible in history.

    The burndown coverage gap (#294 inc 8): ``recover_groomed_history`` only
    emits events for the ~74 groomed ids, so a store cut over today would
    give ``ledger_parse.store_series_raw`` an EMPTY pre-cutover history for
    the ~370 current-entry tasks. This walks the SAME snapshots and emits a
    first-sight event for every id ``watch.ledger_series``'s markdown git-
    walk would count — current-entry AND groomed alike — so the store's
    burndown matches the markdown walk bucket for bucket at the flip.

    The model is the markdown walk's model exactly (design M3-A, F3): an id
    ARRIVES at the first commit where it appears anywhere (open OR landed)
    and LANDS at the first commit where it appears under ``## Recently
    landed``. Both are first-seen events — the Markdown never recorded
    intra-life causes, so nothing more is fabricated. Arrival is modelled
    ``NULL → open`` and landing ``open → landed`` (the shape
    ``store_series_raw`` queries and ``test_ledger_dispatch.py``'s parity
    fixture proves); an id born already landed gets both at its birth epoch,
    which is the same +1/-1 net-zero the markdown walk records for it.

    Only groomed ids need ROW recovery (``recover_groomed_history`` owns
    that); current-entry tasks already have rows from ``_populate_store``.
    An id with an entry but NO first-sight in any snapshot (a planted
    fixture entry, or a header pre-dating git) gets NO fabricated event —
    honesty over completeness, the same rule as the unrecoverable groomed
    four (#101 #222 #223 #267).
    """
    watch = _load_watch_or_die()
    arrived, landed = {}, {}
    for sha, epoch, text in snapshots:
        o, l = watch.parse_ledger(text)
        oids, lids = {int(x) for x in o}, {int(x) for x in l}
        for i in oids | lids:
            arrived.setdefault(i, (sha, epoch))
        for i in lids:
            landed.setdefault(i, (sha, epoch))
    events = []
    for i in sorted(arrived):
        sha, epoch = arrived[i]
        events.append(_history_event(i, epoch, None, "open", sha, "first sight"))
        if i in landed:
            lsha, lepoch = landed[i]
            events.append(_history_event(i, lepoch, "open", "landed", lsha,
                                         "landed"))
    return events


# ---------------------------------------------------------------------------
# Cutover (#294 R4 — the FINAL increment). The 7-step ordering the design
# §"Cutover ordering and the mixed-writer freeze" copies stage-for-stage
# from #263's cutover: exclusive lease, freeze every writer, run stages 1–4
# under the lease, flip the reader (one-way watermark), rename + shim, emit
# the watch-events line, release the lease.
#
# The lease reuses #263's CAS-on-meta primitive (user_events.Journal.cutover)
# verbatim: same meta keys, same B5 ``lease_until > now`` predicate, same
# CutoverBusy exception. NOT reinvented — imported from user_events.
# ---------------------------------------------------------------------------

# A real migrations/ entry — the notice names it so a stale agent that reads
# the shim can discover the upgrade through its normal orient pass.
_NOTICE_MIGRATION = "2026-07-29-10-task-ledger.md"

_CUTOVER_META_KEYS = ("cutover_holder", "cutover_token", "cutover_lease_until")


def _fsync_path(path: Path) -> None:
    """fsync a file's bytes to disk (the cp+fsync #263's cutover relies on)."""
    fd = os.open(str(path), os.O_RDONLY)
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def _guard_scratch_target(target_dir) -> None:
    """Refuse to cutover the real .dreamwork/. Live execution is a
    coordinator act; this increment verifies on scratch copies only."""
    td = Path(target_dir).resolve()
    real_dw = (REPO / ".dreamwork").resolve()
    if td == real_dw or real_dw in td.parents:
        raise _CliFail(EX_NOPERM, f"refusing --target-dir {target_dir}: "
                       "the real .dreamwork/ is the live location; run the "
                       "cutover on a scratch copy for verification")


def _acquire_cutover_lease(conn, holder: str, lease_seconds: int) -> str:
    """CAS-acquire the exclusive cutover lease on the store's meta table.

    Reuses #263's lease primitive (user_events.Journal.cutover's acquire
    block): an active lease whose ``lease_until > now`` is refused
    (CutoverBusy); an expired lease is reclaimable (B5's predicate
    inverted). Same meta keys, same ISO-8601 lexical comparison.
    """
    now = datetime.now(timezone.utc)
    now_s = now.strftime("%Y-%m-%dT%H:%M:%S.%fZ")
    lease_until = (now + timedelta(seconds=lease_seconds)).strftime(
        "%Y-%m-%dT%H:%M:%S.%fZ")
    token = uuid.uuid4().hex
    conn.execute("BEGIN IMMEDIATE")
    try:
        cur = conn.execute(
            "SELECT value FROM meta WHERE key = 'cutover_lease_until'"
        ).fetchone()
        cur_s = cur[0] if cur is not None else None
        # B5 predicate: an active lease is one whose lease_until > now.
        active = cur_s is not None and cur_s > now_s
        if active:
            conn.execute("COMMIT")
            raise CutoverBusy(
                f"cutover lease active until {cur_s}; "
                "steal only after expiry (reuse of B5 lease_until > now)")
        for key, val in (("cutover_holder", holder),
                         ("cutover_token", token),
                         ("cutover_lease_until", lease_until)):
            conn.execute(
                "INSERT INTO meta (key, value) VALUES (?, ?) "
                "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
                (key, val))
        conn.execute("COMMIT")
    except CutoverBusy:
        raise
    except Exception:
        conn.execute("ROLLBACK")
        raise
    return token


def _release_cutover_lease(conn) -> None:
    """Drop the cutover lease rows (#263's _release_cutover_lease, verbatim)."""
    conn.execute("BEGIN IMMEDIATE")
    try:
        placeholders = ",".join("?" * len(_CUTOVER_META_KEYS))
        conn.execute(
            f"DELETE FROM meta WHERE key IN ({placeholders})",
            _CUTOVER_META_KEYS)
        conn.execute("COMMIT")
    except Exception:
        conn.execute("ROLLBACK")
        raise


def _write_cutover_watermark(conn, timestamp: str) -> None:
    """Write the cutover watermark — the ONE-WAY reader flip (step 4).

    Watermark present -> ledger_parse.is_cut_over returns True -> the store
    is the source. Never dual-write, never two truths. Written exactly once
    at cutover; never removed (rollback re-runs forward, keeping it present).
    """
    conn.execute("BEGIN IMMEDIATE")
    try:
        conn.execute(
            "INSERT INTO meta (key, value) VALUES ('ledger_cut_over', ?) "
            "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
            (timestamp,))
        conn.execute("COMMIT")
    except Exception:
        conn.execute("ROLLBACK")
        raise


def guard_markdown_write(target_dir) -> None:
    """Lane-H version gate: refuse a direct Markdown mutation after cutover.

    The store is the single source after the watermark; a Markdown write is
    the legacy direct writer #263 forbids (G5). After rollback the store is
    re-imported forward so the watermark is still present and this guard
    still fires — rollback never restores a legacy writer.

    **Production line:** the ``is_cut_over`` check in this guard. Break by
    removing it and a direct Markdown write succeeds, reintroducing the
    single-writer-by-convention hazard.
    """
    if ledger_parse.is_cut_over(target_dir):
        raise VersionMismatchError(
            "ledger store is cut over (watermark present); a direct Markdown "
            "mutation is a legacy writer #263 forbids — use `dreamwork tasks "
            "file|grab|cycle` through the store instead")


def verify_task_event_chain(db_path: str) -> list[str]:
    """Recompute the task_event hash chain from genesis; return failures.

    Verifies over EVERY row ordered by ordinal, regardless of actor — a
    synthetic ``migration:git`` row is chained exactly like a live one (B3).
    **Production line:** the loop iterates all task_event rows. Break by
    exempting ``actor='migration:git'`` rows and a mutated synthetic row
    passes — a silent forgery.
    """
    conn = sqlite3.connect(f"file:{Path(db_path).resolve()}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    failures = []
    try:
        rows = conn.execute(
            "SELECT * FROM task_event ORDER BY ordinal").fetchall()
        prev = genesis_hash()
        for r in rows:
            d = dict(r)
            if r["prev_hash"] != prev:
                failures.append(
                    f"task_event ordinal {r['ordinal']}: prev_hash breaks "
                    f"the chain (expected {prev[:12]})")
            if r["hash"] != hash_event(prev, canonical_event_bytes(d)):
                failures.append(
                    f"task_event ordinal {r['ordinal']}: hash does not "
                    "recompute from prev + canonical bytes")
            prev = r["hash"]
    finally:
        conn.close()
    return failures


def _write_deprecated_file(target_dir: Path, original_text: str,
                           store_rel: str, backup_rel: str,
                           timestamp: str) -> Path:
    """Write tasks.md.deprecated: the original content with a YAML
    deprecation block naming the canonical access path and recovery."""
    deprecation = (
        "---\n"
        "deprecated: true\n"
        f"reason: \"ledger migrated to SQLite store ({store_rel})\"\n"
        'canonical-access: "dreamwork tasks ..."\n'
        f"recovery: \"tasks migrate --rollback {backup_rel}\"\n"
        f"migrated-at: \"{timestamp}\"\n"
        "---\n\n")
    deprecated_path = target_dir / "tasks.md.deprecated"
    deprecated_path.write_text(deprecation + original_text, encoding="utf-8")
    _fsync_path(deprecated_path)
    return deprecated_path


def _write_shim(tasks_path: Path) -> None:
    """Leave a one-line tasks.md shim carrying only the #458 notice.

    A stale agent reading tasks.md every tick finds the notice and switches
    to the CLI; an agent reading tasks.md.deprecated finds the deprecation
    block. Both paths self-heal (design M5-A, #458). The shim carries ONLY
    the notice — no ledger data, so it cannot be mistaken for the source.
    """
    notice = migration_notice.render_notice(
        _NOTICE_MIGRATION,
        file=str(tasks_path),
        summary="ledger migrated to SQLite store; use `dreamwork tasks ...`")
    tasks_path.write_text(notice, encoding="utf-8")
    _fsync_path(tasks_path)


def perform_cutover(target_dir, *, holder: str = "cutover",
                    lease_seconds: int = 300, out=None) -> dict:
    """The 7-step cutover ordering (design section Cutover). Scratch-only.

    (1) Acquire the exclusive cutover lease (#263's CAS primitive, reused).
    (2) Freeze writers — the lease + version gate make a mixed-version writer
        fail closed before accepting a write.
    (3) Run stages 1-4 (dry-run, backup, import, verify) under the lease.
    (4) Flip the reader — write the one-way cutover watermark.
    (5) Rename tasks.md -> tasks.md.deprecated (YAML block) + leave the
        one-line tasks.md shim (#458 notice).
    (6) Write the cutover watermark row + one watch-events.log line.
    (7) Release the lease.

    Returns a dict with the watermark timestamp, backup dir, and counts.
    """
    out = out or sys.stdout
    td = Path(target_dir)
    _guard_scratch_target(td)

    tasks_path = td / "tasks.md"
    store_db = td / ledger_parse.STORE_FILENAME
    text = _read_ledger(str(tasks_path))
    analysis = build_analysis(text, ledger_path=str(tasks_path))

    # Stage 2: backup (before the lease — a durable copy is the rollback
    # substrate #263's cutover relies on, not a git commit).
    backup_dir = td / "migration-backup"
    backup_dir.mkdir(exist_ok=True)
    backup_tasks = backup_dir / "tasks.md"
    backup_tasks.write_text(text, encoding="utf-8")
    _fsync_path(backup_tasks)
    if store_db.exists():
        shutil.copy2(str(store_db), str(backup_dir / store_db.name))

    # Step 1: acquire the lease on the store's meta table.
    store = ledger_store.open_store(str(store_db), ledger_text=text)
    token = _acquire_cutover_lease(store.conn, holder, lease_seconds)
    try:
        # Step 3: import + verify under the lease.
        populated = _populate_store(store.conn, text, analysis)
        # #294 inc 8: write groomed-id rows + first-sight events for EVERY
        # task visible in git history, so the store's burndown is complete at
        # the flip (store_series_raw → watch.ledger_series parity). Current-
        # entry rows already exist from _populate_store; groomed rows come
        # from recover_groomed_history; the events cover both, written under
        # the lease before the watermark. No git history → no events (honest).
        snapshots = _safe_snapshots(str(tasks_path))
        if snapshots:
            rec = recover_groomed_history(analysis, snapshots)
            store.conn.execute("BEGIN IMMEDIATE")
            try:
                _insert_groomed_rows(store.conn, rec["tasks"])
                _populate_events(store.conn,
                                 first_sight_events(analysis, snapshots))
                store.conn.execute("COMMIT")
            except Exception:
                store.conn.execute("ROLLBACK")
                raise
        failures = verify_db(text, analysis, str(store_db))
        if failures:
            raise _CliFail(EX_DATAERR, "cutover refused: verification failed "
                           f"under the lease ({len(failures)} failures): "
                           + "; ".join(failures[:5]))

        # Step 4 + 6: write the cutover watermark (the one-way reader flip).
        timestamp = datetime.now(timezone.utc).strftime(
            "%Y-%m-%dT%H:%M:%S.%fZ")
        _write_cutover_watermark(store.conn, timestamp)

        # Step 5: rename + shim (after the watermark commits, so a crash
        # between watermark and rename leaves the store authoritative with
        # the old file intact — recoverable, not inconsistent).
        _write_deprecated_file(td, text, ledger_parse.STORE_FILENAME,
                               str(backup_dir), timestamp)
        _write_shim(tasks_path)

        # Step 6: one watch-events.log line (no newlines — the coordinator's
        # monitor wakes on a line and acts on it).
        event_line = (f"ledger-cutover {ledger_parse.STORE_FILENAME} "
                      f"migrated tasks.md to store (watermark {timestamp})\n")
        with open(td / "watch-events.log", "a") as f:
            f.write(event_line)
    finally:
        # Step 7: release the lease.
        _release_cutover_lease(store.conn)
        store.close()

    print(f"cutover complete: watermark {timestamp}", file=out)
    print(f"  tasks.md.deprecated: {td / 'tasks.md.deprecated'}", file=out)
    print(f"  tasks.md shim:      {tasks_path}", file=out)
    print(f"  store:              {store_db}", file=out)
    print(f"  backup:             {backup_dir}", file=out)
    print(f"  imported:           {populated} task rows", file=out)
    return {"watermark": timestamp, "backup": str(backup_dir),
            "store": str(store_db), "populated": populated}


def perform_rollback(backup_dir, target_dir, *, holder: str = "rollback",
                     lease_seconds: int = 300, out=None) -> dict:
    """Restore the backup + pre-cutover DB, then re-run the migration forward.

    Per design section Rollback: restore the backup file, delete the store,
    re-import under a fresh lease, re-write the watermark. NEVER restore a
    legacy direct writer — the version gate must refuse a direct Markdown
    mutation after rollback, because the watermark is written again.

    Returns a dict with the re-import result.
    """
    out = out or sys.stdout
    td = Path(target_dir)
    _guard_scratch_target(td)

    backup = Path(backup_dir)
    backup_tasks = backup / "tasks.md"
    if not backup_tasks.exists():
        raise _CliFail(EX_NOINPUT, f"backup tasks.md not found at "
                       f"{backup_tasks}")

    # 1. Restore tasks.md from backup.
    tasks_path = td / "tasks.md"
    text = backup_tasks.read_text(encoding="utf-8")
    tasks_path.write_text(text, encoding="utf-8")
    _fsync_path(tasks_path)

    # 2. Remove the store (pre-cutover state).
    store_db = td / ledger_parse.STORE_FILENAME
    for suffix in ("", "-wal", "-shm"):
        p = Path(str(store_db) + suffix)
        if p.exists():
            p.unlink()
    # Remove the deprecated file and restore tasks.md as the real file.
    deprecated = td / "tasks.md.deprecated"
    if deprecated.exists():
        deprecated.unlink()

    # 3. Re-run forward: import under a fresh lease + re-cutover.
    analysis = build_analysis(text, ledger_path=str(tasks_path))
    store = ledger_store.open_store(str(store_db), ledger_text=text)
    token = _acquire_cutover_lease(store.conn, holder, lease_seconds)
    try:
        populated = _populate_store(store.conn, text, analysis)
        # Re-run forward also writes history events (#294 inc 8) — rollback
        # deletes the store, so the burndown must be rebuilt from git like
        # the forward cutover. Same code path, same idempotence.
        snapshots = _safe_snapshots(str(tasks_path))
        if snapshots:
            rec = recover_groomed_history(analysis, snapshots)
            store.conn.execute("BEGIN IMMEDIATE")
            try:
                _insert_groomed_rows(store.conn, rec["tasks"])
                _populate_events(store.conn,
                                 first_sight_events(analysis, snapshots))
                store.conn.execute("COMMIT")
            except Exception:
                store.conn.execute("ROLLBACK")
                raise
        failures = verify_db(text, analysis, str(store_db))
        timestamp = datetime.now(timezone.utc).strftime(
            "%Y-%m-%dT%H:%M:%S.%fZ")
        _write_cutover_watermark(store.conn, timestamp)
        _write_shim(tasks_path)
        _write_deprecated_file(td, text, ledger_parse.STORE_FILENAME,
                               str(backup), timestamp)
    finally:
        _release_cutover_lease(store.conn)
        store.close()

    print(f"rollback complete: re-imported {populated} rows, "
          f"watermark {timestamp}", file=out)
    print("  the store is the source again; direct Markdown mutation is "
          "refused by the version gate", file=out)
    return {"watermark": timestamp, "populated": populated}



def render_report(a: dict) -> str:
    """The dry-run report — the deliverable of this increment."""
    out = []
    out.append("dreamwork tasks migrate — DRY RUN (writes nothing)")
    out.append(f"ledger: {a['ledger_path']}")
    out.append("")
    out.append("COUNTS")
    out.append(f"  open ids:    {a['open_count']}")
    out.append(f"  landed ids:  {a['landed_count']}")
    out.append(f"  total ids:   {a['total_ids']} "
               f"(disjoint: {'yes' if a['disjoint'] else 'NO — duplicate across sections'})")
    out.append(f"  entries:     {len(a['entries'])}")
    out.append("")
    out.append("ID SET")
    out.append("  " + " ".join(f"#{i}" for i in sorted(set(a['open_ids']) | set(a['landed_ids']))))
    out.append("")
    seed = a["seed"]
    out.append("SEED (R1 — the sequence lives in the store, seeded and verified)")
    out.append(f"  header Next id:  {seed['header'] if seed['header'] is not None else '(absent)'}")
    out.append(f"  MAX(id)+1:       {seed['derived']}")
    out.append(f"  would seed at:   {seed['seed'] if seed['seed'] is not None else '(unverifiable)'}"
               f"  — {'OK: ' if seed['ok'] else 'CONFLICT: '}{seed['detail']}")
    out.append("")
    conflicts = a["conflicts"]
    n = sum(len(v) for v in conflicts.values())
    out.append(f"CONFLICTS ({n}) — output, never errors; exit stays 0 (#346's ruling)")
    if not conflicts:
        out.append("  none")
    for category in sorted(conflicts):
        rows = conflicts[category]
        out.append(f"  {category} ({len(rows)})")
        for r in rows:
            out.append(f"    · {r['detail']}")
    out.append("")
    out.append("DIGESTS (per entry — sha256 of the verbatim body; --import will prove these bytes)")
    for e in a["entries"]:
        label = "/".join(f"#{i}" for i in e["ids"]) if e["ids"] else "(no id)"
        out.append(f"  {label} [{e['section']}] sha256:{e['digest']}")
    return "\n".join(out)


def _run_import(text, analysis, db_path, out) -> int:
    """--import: populate (or no-op), then ALWAYS verify the scratch DB."""
    try:
        result = import_into_db(text, analysis, db_path)
    except _CliFail as exc:
        print(exc.message, file=out)
        return exc.code
    if result["populated"]:
        print(f"imported {result['populated']} task rows into {db_path}",
              file=out)
    else:
        print(f"no-op: {db_path} already holds the import; verifying", file=out)
    print(f"id sequence next id: {result['next_id']} "
          f"(== MAX(id)+1, verified against the ledger)", file=out)
    return _run_verify(text, analysis, db_path, out)


def _run_import_history(text, analysis, db_path, ledger_relpath, out) -> int:
    """--import-history: recover groomed bodies from git, write synthetic
    migration:git rows + events, then ALWAYS verify the scratch DB."""
    try:
        snapshots = git_snapshots(ledger_relpath)
        result = import_history_into_db(text, analysis, db_path, snapshots)
    except _CliFail as exc:
        print(exc.message, file=out)
        return exc.code
    if result["populated"]:
        print(f"imported history: {result['recovered']} recovered rows, "
              f"{result['events']} migration:git events into {db_path}", file=out)
    else:
        print(f"no-op: {db_path} already holds the history import; verifying",
              file=out)
    if result["unrecoverable"]:
        print(f"unrecoverable (no entry body in any commit): "
              f"{', '.join(f'#{i}' for i in result['unrecoverable'])}", file=out)
    return _run_verify(text, analysis, db_path, out,
                       snapshots_fn=lambda s=snapshots: s)


def _run_verify(text, analysis, db_path, out, snapshots_fn=None) -> int:
    failures = verify_db(text, analysis, db_path, snapshots_fn=snapshots_fn)
    if failures:
        print(f"verification FAILED ({len(failures)}):", file=out)
        for f in failures:
            print(f"  · {f}", file=out)
        return EX_DATAERR
    print("verification OK: scratch DB matches the parse row-for-row",
          file=out)
    return EX_OK


def main(argv=None, out=None) -> int:
    out = out or sys.stdout
    p = _UsageParser(prog="ud-dw-tasks-migrate",
                     description="the tasks.md -> SQLite migration (#294)")
    p.add_argument("--dry-run", action="store_true",
                   help="parse + report; writes nothing")
    p.add_argument("--import", dest="import_", action="store_true",
                   help="populate a SCRATCH database (never .dreamwork/) and verify it")
    p.add_argument("--import-history", dest="import_history", action="store_true",
                   help="R3: recover groomed-id bodies from git history into a "
                        "SCRATCH database as synthetic migration:git events")
    p.add_argument("--verify", action="store_true",
                   help="re-verify an existing scratch database against the parse")
    p.add_argument("--cutover", action="store_true",
                   help="R4: the 7-step cutover (lease, import, watermark, "
                        "rename + shim). Scratch --target-dir only.")
    p.add_argument("--rollback", metavar="BACKUP_DIR",
                   help="restore backup + re-run forward; never restores a "
                        "legacy direct writer")
    p.add_argument("--to", metavar="PATH",
                   help="scratch database path for --import/--verify/--import-history")
    p.add_argument("--target-dir", metavar="DIR",
                   help="scratch .dreamwork/-like directory for --cutover/--rollback")
    p.add_argument("--ledger", default=".dreamwork/tasks.md",
                   help="path to the Markdown task ledger")
    p.add_argument("--report", metavar="PATH",
                   help="also write the full report to PATH")
    args = p.parse_args(argv)

    # Cutover and rollback operate on a target dir (tasks.md + store), not a
    # single --to path. They read the ledger themselves, so they bypass the
    # shared ledger-reading block below.
    if args.cutover:
        if not args.target_dir:
            p.error("--cutover requires --target-dir <scratch-dir>")
        try:
            perform_cutover(args.target_dir, out=out)
            return EX_OK
        except _CliFail as exc:
            print(exc.message, file=out)
            return exc.code
        except CutoverBusy as exc:
            print(f"cutover refused: {exc}", file=out)
            return EX_NOPERM

    if args.rollback:
        if not args.target_dir:
            p.error("--rollback requires --target-dir <scratch-dir>")
        try:
            perform_rollback(args.rollback, args.target_dir, out=out)
            return EX_OK
        except _CliFail as exc:
            print(exc.message, file=out)
            return exc.code
        except CutoverBusy as exc:
            print(f"rollback refused: {exc}", file=out)
            return EX_NOPERM

    if (args.import_ or args.verify or args.import_history) and not args.to:
        p.error("--import/--verify/--import-history require --to <scratch.db>")
    try:
        text = _read_ledger(args.ledger)
        analysis = build_analysis(text, ledger_path=args.ledger)
    except _Unparseable as exc:
        print(f"unparseable ledger: {exc}", file=out)
        return EX_DATAERR
    except _CliFail as exc:
        print(exc.message, file=out)
        return exc.code
    if args.import_:
        return _run_import(text, analysis, args.to, out)
    if args.import_history:
        return _run_import_history(text, analysis, args.to, args.ledger, out)
    if args.verify:
        return _run_verify(text, analysis, args.to, out,
                           snapshots_fn=lambda: git_snapshots(args.ledger))
    report = render_report(analysis)
    print(report, file=out)
    if args.report:
        Path(args.report).write_text(report + "\n", encoding="utf-8")
    return EX_OK


if __name__ == "__main__":
    sys.exit(main())
